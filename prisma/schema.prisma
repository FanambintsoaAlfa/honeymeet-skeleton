// HoneyMeet - Dating Platform Database Schema
// Based on official Honey Group specifications (October 2024)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS
// ============================================
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phoneNumber   String?  @unique @map("phone_number")
  passwordHash  String?  @map("password_hash")
  userType      UserType @default(LOCAL) @map("user_type")
  status        UserStatus @default(PENDING)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  profile       Profile?
  subscriptions Subscription[]
  transactions  TransactionPayment[]

  @@map("users")
}

enum UserType {
  INTERNATIONAL
  LOCAL
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  VERIFIED
}

// ============================================
// PROFILES
// ============================================
model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique @map("user_id")
  fullName        String?  @map("full_name")
  nickname        String?
  gender          String?
  lookingFor      String?  @map("looking_for")
  birthDate       DateTime? @map("birth_date")
  locationCity    String?  @map("location_city")
  locationCountry String?  @map("location_country")
  gpsLocation     String?  @map("gps_location") // "lat,lng" or PostGIS later
  bio             String?
  interests       String[] // Array of interests
  isPremium       Boolean  @default(false) @map("is_premium")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photosVideos    PhotoVideo[]
  sentInteractions    MatchInteraction[] @relation("Sender")
  receivedInteractions MatchInteraction[] @relation("Receiver")

  @@map("profiles")
}

// ============================================
// PHOTOS & VIDEOS
// ============================================
model PhotoVideo {
  id        String  @id @default(cuid())
  profileId String  @map("profile_id")
  mediaUrl  String  @map("media_url") // AWS S3 URL
  isPrimary Boolean @default(false) @map("is_primary")
  mediaType MediaType @default(PHOTO) @map("media_type")
  createdAt DateTime @default(now()) @map("created_at")

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("photos_videos")
}

enum MediaType {
  PHOTO
  VIDEO
}

// ============================================
// MATCHES & INTERACTIONS
// ============================================
model MatchInteraction {
  id         String       @id @default(cuid())
  senderId   String       @map("sender_id")
  receiverId String       @map("receiver_id")
  actionType ActionType   @map("action_type")
  isMatch    Boolean      @default(false) @map("is_match")
  createdAt  DateTime     @default(now()) @map("created_at")

  sender     Profile      @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   Profile      @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@map("matches_interactions")
}

enum ActionType {
  LIKE
  DISLIKE
  SUPERLIKE
}

// ============================================
// SUBSCRIPTIONS
// ============================================
model Subscription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  planType  PlanType           @map("plan_type")
  status    SubscriptionStatus @default(PENDING)
  startDate DateTime?          @map("start_date")
  endDate   DateTime?          @map("end_date")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionPayment[]

  @@map("subscriptions")
}

enum PlanType {
  MONTHLY
  QUARTERLY
  PREMIUM_PASS
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

// ============================================
// TRANSACTIONS & PAYMENTS
// ============================================
model TransactionPayment {
  id                   String        @id @default(cuid())
  userId               String        @map("user_id")
  subscriptionId       String?       @map("subscription_id")
  amount               Decimal       @db.Decimal(10, 2)
  currency             Currency      @default(MGA)
  paymentMethod        PaymentMethod @map("payment_method")
  transactionReference String?       @map("transaction_reference") // Mobile Money ref or Stripe ID
  paymentStatus        PaymentStatus @default(PENDING) @map("payment_status")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("transactions_payments")
}

enum Currency {
  MGA
  EUR
  USD
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  MVOLA
  ORANGE_MONEY
  AIRTEL_MONEY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}
